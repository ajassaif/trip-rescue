# Copy to .env for npm run dev or Docker Compose. Never commit .env.
AGENT_API_URL=http://127.0.0.1:8100

# Demo works without the settings below. Live mode requires real services.
STRANDS_DECIDER_URL=
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
DECIDER_CONFIDENCE_THRESHOLD=0.8
PROVIDER_TIMEOUT_SECONDS=30
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=

# Use your AWS profile locally, or an instance/task role on AWS.
# AWS_PROFILE=your-existing-profile
# Short-term Bedrock API keys are also supported; keep the value in .env only.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_USE_INSTANCE_ROLE=true
# PYTHON_EXECUTABLE=absolute/path/to/python
